# Preconfigured Headscale networking for the WebVM iOS app.
# Copy to .network.env (gitignored) and fill in. Leave blank to fall back to
# interactive Tailscale login. stage.sh bakes these into the app bundle.
#
# The auth key is a secret join credential — use an EPHEMERAL, single-use key:
#   headscale preauthkeys create --user <user> --ephemeral --reusable=false
#
# Headscale must also send CORS headers allowing the app's loopback origin
# (http://127.0.0.1:<LocalServer port>) — see README "Self-Hosting with Headscale".
HEADSCALE_CONTROL_URL=
HEADSCALE_AUTH_KEY=

# App Store Connect API auth for TestFlight upload.
# Copy to .asc.env (gitignored) and fill in. These are identifiers, not secrets;
# the secret is the .p8 private key at ~/.appstoreconnect/private_keys/AuthKey_<ASC_KEY_ID>.p8
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
ASC_TEAM_ID=XXXXXXXXXX
